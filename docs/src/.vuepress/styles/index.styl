/**
 * Custom Styles here.
 *
 * ref：https://v1.vuepress.vuejs.org/config/#index-styl
 */

// .home .hero img
//   max-width 450px!important

html, body, #app, .navbar, .sidebar
  background-color: #011622
  background-color: #121518;

#app > .theme-container > .navbar > .links
  background-color: #011622
  background-color: #121518;

#app > .theme-container > .navbar > .links input
  background-color: #011622
  background-color: #121518;

*::-webkit-scrollbar {
  width: 12px;
  height: 12px;
  background-color: #151515;
}

*::-webkit-scrollbar-thumb {
  box-shadow: inset 0 0 6px rgba(0,0,0,.3);
  background-color: #21252d;
}

*::-webkit-scrollbar-corner {
  background: var(--bg-color);
}

.ui-object-field::-webkit-scrollbar {
  display: none;
}

#style-1::-webkit-scrollbar-track {
  background-color: #222;
}

// Tables match the dark theme: subtle header, soft separators, no harsh zebra.
.theme-default-content table,
.content__default table
  border: 0
  border-collapse: collapse

  thead
    th
      background-color: rgba(170, 203, 255, 0.06)
      border-bottom: 2px solid rgba(170, 203, 255, 0.2)
      color: #ffffff

  tr
    background-color: transparent

  tr:nth-child(2n)
    background-color: rgba(170, 203, 255, 0.03)

  tr
    td
      border: none
      border-bottom: 1px solid rgba(170, 203, 255, 0.1)

  th, td
    padding: .6em 1em
    border: none
